{
  "manifest_version": 3,
  "name": "Habitica NoBailey",
  "version": "1.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://habitica.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
   "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}